{
  "schema": 1,
  "components": [
    {
      "id": "iyt_app",
      "kind": "app",
      "path": "source/apps/iyt_app",
      "title": "iYT",
      "description": "YouTube for BMW iDrive 7 with native audio and hardware H.264 video.",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "iyt-daemon": "0.5.6",
        "mgu-render": "0.6.11",
        "mgu-inputgate": "1.0.0"
      },
      "build": {
        "python": "source/kit/tools/build.py",
        "args": [
          "{id}"
        ],
        "sdk": "source/oap-sdk",
        "output": "source/dist/{id}@{version}.tgz"
      }
    },
    {
      "id": "iyt-daemon",
      "kind": "tool",
      "path": "source/native/iyt-daemon",
      "title": "iYT playback service",
      "mguHmi": [
        "ID7"
      ],
      "uninstallable": true
    }
  ]
}
